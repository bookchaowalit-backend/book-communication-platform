  "opt_out": {
    "status": "proposed",
    "rules": [
      {
        "id": "suppress-before-send",
        "rule": "A queued entry whose recipient_ref has an opt-out for its channel (or '*') is suppressed before any provider call; no attempt is counted."
      },
      {
        "id": "console-exempt",
        "rule": "console is a local observation, not a send, so opt-out never applies to it."
      },
      {
        "id": "signal-dedupe",
        "rule": "Opt-out signals are deduplicated by external event id; a replayed webhook changes nothing."
      },
      {
        "id": "provider-signal",
        "rule": "Telegram 403 'bot was blocked by the user' records an opt-out for that recipient and channel."
      },
      {
        "id": "verified-inbound-only",
        "rule": "Inbound opt-out events are interpreted only after the route verified the provider signature on the raw body (x-line-signature)."
      },
      {
        "id": "batch-per-event",
        "rule": "Every unfollow in a LINE webhook batch yields its own opt-out, with the recipient resolved per event from source.userId. Every LINE opt-out is also keyed by the hashed userId (address_ref) and enforcement checks that key, so an unfollow from a not-yet-mapped user still blocks later sends to that userId after it is mapped."
      },
      {
        "id": "reject-missing-event-id",
        "rule": "An unfollow without webhookEventId or source.userId is reported as a per-event 400 error, never collapsed into a shared key; the valid opt-outs of the same batch are still recorded."
      }
    ],
