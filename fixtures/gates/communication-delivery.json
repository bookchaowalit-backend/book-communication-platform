  "retry_idempotency": {
    "max_attempts": 3,
    "rules": [
      {
        "id": "queue-dedupe",
        "status": "current",
        "rule": "A queue with a known dedupe_key returns outcome=existing and the first entry unchanged; no second entry is created."
      },
      {
        "id": "dedupe-key-construction",
        "status": "current",
        "rule": "dedupe_key = 'k-' + sha256(json.dumps(parts, default=str, ensure_ascii=False))[:60]."
      },
      {
        "id": "attempt-counting",
        "status": "current",
        "rule": "delivered and failed each add one attempt; console adds none and is never a delivery (422 console_is_not_delivery)."
      },
      {
        "id": "retry-ceiling",
        "status": "current",
        "rule": "Pending = undelivered and delivery_attempts < 3; an entry at the ceiling is never sent again."
      },
      {
        "id": "no-resend-after-delivery",
        "status": "current",
        "rule": "A delivered entry is never sent again by a retry."
      },
      {
        "id": "provider-idempotency-key",
        "status": "proposed",
        "rule": "Only providers that deduplicate on a caller key get one: LINE X-Line-Retry-Key = uuid5 of 'message/<id>', identical on every retry of one entry (honoured by LINE for 24 h)."
      },
      {
        "id": "dead-stops-retry",
        "status": "proposed",
        "rule": "A dead provider outcome (non-429 4xx) moves the entry to the ceiling instead of retrying it."
      },
      {
        "id": "at-least-once-providers",
        "status": "current",
        "rule": "telegram, slack and email have no provider deduplication: an uncertain outcome retried can deliver twice. Email's stable Message-ID is hygiene, not idempotency."
      }
    ],
